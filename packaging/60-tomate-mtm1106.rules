# Tomate MTM-1106 / Gotop T501 (USB 08f2:6811)
# Grant the active local desktop user read/write access and autostart user driver on plug-in.
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="08f2", ATTR{idProduct}=="6811", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="tomate-mtm1106.service"
