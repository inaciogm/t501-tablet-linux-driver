# Tomate MTM-1106 / Gotop T501 (USB 08f2:6811)
# Grant the active local user access and start the user reader only when this
# exact tablet is added. No program is executed inside udev.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="08f2", ATTR{idProduct}=="6811", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="tomate-mtm1106.service"
